<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Maze files are plain text next to the executable, so they can be edited without a rebuild. -->
    <None Update="Mazes\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
